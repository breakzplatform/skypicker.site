# Copy to .env.local and replace every placeholder. Never commit real values.

# Required. 32+ random chars; encrypts the OAuth session cookie.
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-32-plus-random-chars

# Optional but recommended: separate HMAC key for snapshot links (32+ chars).
# Falls back to SESSION_SECRET when unset or empty. Rotating it invalidates
# every existing snapshot link. Generate with: openssl rand -base64 32
# SNAPSHOT_SECRET=

# Optional: domain rendered on loopback hosts (127.0.0.1, localhost).
# "skypicker.site" (default) or "sorteio.blue". Per request you can also use
# ?dev_domain=sorteio.blue or a /sorteio.blue/ path prefix.
# DEV_DOMAIN=skypicker.site

# Optional: extra hosts that serve a known domain (staging / preview aliases).
# Exact hostnames only; every other host is rejected with 400.
# STAGING_HOSTS=my-app-staging.vercel.app=skypicker.site,my-app-pt-staging.vercel.app=sorteio.blue

# Optional: subdomain treated as the site root (e.g. www).
# LANDING_SUBDOMAIN=www
