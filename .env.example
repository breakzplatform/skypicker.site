# 32+ random chars. Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-32-plus-random-chars

# Optional: separate secret for snapshot HMAC. Falls back to SESSION_SECRET.
# Rotate to invalidate ALL existing snapshot links.
# SNAPSHOT_SECRET=

# Optional: which domain content/OAuth client to use when running on localhost.
# Defaults to "skypicker.site". Set to "sorteio.blue" to test the PT-BR copy.
# At runtime you can also override per-request via ?dev_domain=sorteio.blue
# DEV_DOMAIN=skypicker.site
